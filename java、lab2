// Транспортное средство (абстрактный класс)
abstract class Vehicle {
    // классы груза
    public static final String SAFE = "безопасный";
    public static final String FIRE = "огнеопасный";
    public static final String CHEMICAL = "химически опасный";
    public static final String BOOM = "взрывоопасный";
    public static final String SPECIAL = "особой важности";
    public static final String[] CARGO = {SAFE, FIRE, CHEMICAL, BOOM, SPECIAL};

    private String number;
    private double length;
    private double width;
    private double height;
    private double weight;
    private int speed;
    private String cargo;
    private int arriveTime; // minute when came to queue
    protected String reason = "";

    protected Vehicle(String number, double length, double width, double height,
                      double weight, int speed, String cargo) {
        this.number = number;
        this.length = length;
        this.width = width;
        this.height = height;
        this.weight = weight;
        this.speed = speed;
        this.cargo = cargo;
    }

    public String GetNumber() {
        return number;
    }

    public int GetSpeed() {
        return speed;
    }

    public String GetCargo() {
        return cargo;
    }

    public String GetReason() {
        return reason;
    }

    public int GetArriveTime() {
        return arriveTime;
    }

    public void SetArriveTime(int arriveTime) {
        this.arriveTime = arriveTime;
    }

    // every type has own limits
    public abstract String GetType();
    public abstract double GetMaxLength();
    public abstract double GetMaxWidth();
    public abstract double GetMaxHeight();
    public abstract double GetMaxWeight();
    public abstract int GetMaxSpeed();

    public boolean IsDangerous() {
        return cargo.equals(FIRE) || cargo.equals(CHEMICAL) || cargo.equals(BOOM);
    }

    // время контроля = размер машины + груз
    public int GetCheckTime() {
        int t;
        if (length <= 5) t = 1;        // small car
        else if (length <= 10) t = 2;
        else if (length <= 15) t = 3;
        else t = 4;                    // long trailer
        if (cargo.equals(FIRE) || cargo.equals(SPECIAL)) t += 2;
        if (cargo.equals(CHEMICAL)) t += 3;
        if (cargo.equals(BOOM)) t += 5;
        return t;
    }

    // проверка габаритов, массы и скорости
    public boolean Pass() {
        reason = "";
        if (length > GetMaxLength()) reason += "длина больше " + GetMaxLength() + "; ";
        if (width > GetMaxWidth()) reason += "ширина больше " + GetMaxWidth() + "; ";
        if (height > GetMaxHeight()) reason += "высота больше " + GetMaxHeight() + "; ";
        if (weight > GetMaxWeight()) reason += "масса больше " + GetMaxWeight() + "; ";

        int maxSpeed = GetMaxSpeed();
        if (IsDangerous() && maxSpeed > 20) maxSpeed = 20; // dangerous cargo - slow
        if (speed > maxSpeed) reason += "скорость больше " + maxSpeed + "; ";

        return reason.equals("");
    }

    public String toString() {
        return GetType() + " " + number + ": " + length + "x" + width + "x" + height
                + " м, " + weight + " т, " + speed + " км/ч, груз " + cargo;
    }
}


