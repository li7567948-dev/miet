#include <iostream>
#include <vector>
#include <cstdlib>
#include <ctime>
#include <chrono>

using namespace std;

void shakerSort(vector<int>& a)
{
    int left = 0;
    int right = a.size() - 1;

    while (left < right)
    {
        bool flag = false;

        for (int i = left; i < right; i++)
        {
            if (a[i] > a[i + 1])
            {
                int temp = a[i];
                a[i] = a[i + 1];
                a[i + 1] = temp;
                flag = true;
            }
        }

        right--;

        if (!flag)
            break;

        flag = false;

        for (int i = right; i > left; i--)
        {
            if (a[i - 1] > a[i])
            {
                int temp = a[i - 1];
                a[i - 1] = a[i];
                a[i] = temp;
                flag = true;
            }
        }

        left++;

        if (!flag)
            break;
    }
}

void testSort(int n)
{
    const int repeat = 10;

    vector<int> source(n);
    vector<int> a(n);

    srand(100);

    for (int i = 0; i < n; i++)
        source[i] = rand();

    double copyTime = 0;
    double sortTime = 0;

    for (int k = 0; k < repeat; k++)
    {
        auto startCopy = chrono::high_resolution_clock::now();

        a = source;

        auto endCopy = chrono::high_resolution_clock::now();

        copyTime += chrono::duration<double>(
            endCopy - startCopy
        ).count();

        auto startSort = chrono::high_resolution_clock::now();

        shakerSort(a);

        auto endSort = chrono::high_resolution_clock::now();

        sortTime += chrono::duration<double>(
            endSort - startSort
        ).count();
    }

    sortTime -= copyTime;

    cout << "N = " << n << endl;
    cout << "Время сортировки: "
         << sortTime << " сек." << endl;

    bool correct = true;

    for (int i = 1; i < n; i++)
    {
        if (a[i - 1] > a[i])
        {
            correct = false;
            break;
        }
    }

    if (correct)
        cout << "Проверка: сортировка выполнена правильно." << endl;
    else
        cout << "Проверка: ошибка сортировки." << endl;

    cout << "----------------------------------" << endl;
}

