// -----------------------------------------------------
// Шейкерная сортировка
// 鸡尾酒排序
// -----------------------------------------------------
void shakerSort(vector<int>& arr)
{
    // Левая и правая границы неотсортированной части
    // 左、右边界表示当前还没有排序的区域
    int left = 0;
    int right = static_cast<int>(arr.size()) - 1;

    while (left < right)
    {
        bool swapped = false;

        // -------------------------------------------------
        // Первый проход: слева направо
        // 第一次：从左向右比较
        // -------------------------------------------------
        for (int i = left; i < right; ++i)
        {
            // Если левый элемент больше правого,
            // меняем их местами
            // 如果左边元素大于右边元素，就交换
            if (arr[i] > arr[i + 1])
            {
                swap(arr[i], arr[i + 1]);
                swapped = true;
            }
        }

        // Самый большой элемент уже находится справа
        // 最大的元素已经移动到右边
        --right;

        // Если обменов не было, массив уже отсортирован
        // 如果没有发生交换，说明数组已经有序
        if (!swapped)
            break;

        swapped = false;

        // -------------------------------------------------
        // Второй проход: справа налево
        // 第二次：从右向左比较
        // -------------------------------------------------
        for (int i = right; i > left; --i)
        {
            // Если левый элемент больше правого,
            // меняем их местами
            // 如果左边元素大于右边元素，就交换
            if (arr[i - 1] > arr[i])
            {
                swap(arr[i - 1], arr[i]);
                swapped = true;
            }
        }

        // Самый маленький элемент уже находится слева
        // 最小的元素已经移动到左边
        ++left;

        // Если обменов не было, массив уже отсортирован
        // 如果没有发生交换，说明数组已经有序
        if (!swapped)
            break;
    }
}


// -----------------------------------------------------
// Создание массива случайных чисел
// 生成随机数组
// -----------------------------------------------------
vector<int> generateArray(int n)
{
    vector<int> arr(n);

    // Генератор случайных чисел
    // 随机数生成器
    mt19937 generator(42);

    // Диапазон случайных чисел от 0 до 100000
    // 随机数范围：0～100000
    uniform_int_distribution<int> distribution(0, 100000);

    for (int i = 0; i < n; ++i)
    {
        arr[i] = distribution(generator);
    }

    return arr;
}


// -----------------------------------------------------
// Тестирование сортировки
// 测试排序算法
// -----------------------------------------------------
void testSort(int n)
{
    // Создаём массив
    // 创建数组
    vector<int> arr = generateArray(n);

    // Запоминаем время начала сортировки
    // 记录排序开始时间
    auto start = chrono::high_resolution_clock::now();

    // Выполняем шейкерную сортировку
    // 执行鸡尾酒排序
    shakerSort(arr);

    // Запоминаем время окончания сортировки
    // 记录排序结束时间
    auto finish = chrono::high_resolution_clock::now();

    // Вычисляем время выполнения
    // 计算程序运行时间
    chrono::duration<double, milli> elapsed = finish - start;

    cout << "Размер массива / 数组大小: "
         << n << endl;

    cout << "Время сортировки / 排序时间: "
         << elapsed.count() << " мс" << endl;

    // Проверяем, отсортирован ли массив
    // 检查数组是否已经正确排序
