// Свой класс обработки сообщений: запись логов и ошибки со счётчиком
class ErrMsgLog {
    private ArrayList<Exception> errList = new ArrayList<Exception>(); // счётчик = размер списка
    private BufferedWriter out = null;
    private String errFile = "logs/errors.txt";
    private DateTimeFormatter fmt = DateTimeFormatter.ofPattern("dd.MM.yyyy HH:mm:ss");

    public void OpenLog(String fileName) throws IOException {
        new File("logs").mkdirs();
        out = new BufferedWriter(new FileWriter(fileName));
    }

    public void Write(String line) throws IOException {
        out.write(line);
        out.newLine();
    }

    public void CloseLog() {
        if (out == null) return;
        try {
            out.close();
        } catch (IOException e) {
            AddErr(e);
        }
        out = null;
    }

    // добавить ошибку: в список, на экран и в файл ошибок
    public int AddErr(Exception e) {
        errList.add(e);
        System.out.println("ОШИБКА №" + errList.size() + ": " + e.getMessage());
        FileWriter f = null;
        try {
            new File("logs").mkdirs();
            f = new FileWriter(errFile, true);
            f.write(LocalDateTime.now().format(fmt) + " " + e.getMessage() + "\n");
        } catch (IOException ex) {
            errList.add(ex); // no AddErr here, or it will call itself again
            System.out.println("ОШИБКА: не удалось записать " + errFile);
        } finally {
            try {
                if (f != null) f.close();
            } catch (IOException ex) {
                errList.add(ex);
            }
        }
        return errList.size();
    }

    public int GetErrCount() {
        return errList.size();
    }
}


// ЛР3: опыты с коллекциями. Главный класс - Vehicle
class CollectionTest {
    private ErrMsgLog log;
    private Generator gen = new Generator();
    private Random rnd = new Random();
    private DateTimeFormatter fmt = DateTimeFormatter.ofPattern("dd.MM.yyyy HH:mm:ss");
    private String table = "";    // итоговая таблица
    private String capacity = ""; // проверка расширения ArrayList

    public CollectionTest(ErrMsgLog log) {
        this.log = log;
    }

    public void RunAll() {
        int[] sizes = {10, 100, 1000, 10000, 100000};
        WarmUp();
        table = "Коллекция\tN\taddTotal\taddMedian\tremoveTotal\tremoveMedian\n";
        for (int s = 0; s < sizes.length; s++) {
            int n = sizes[s];
            System.out.println("Опыт для " + n + " элементов...");

            // objects are made before timing
            Vehicle[] cars = new Vehicle[n];
            for (int i = 0; i < n; i++) {
                cars[i] = gen.RandomVehicle();
            }
            // 10% random indexes to remove, same for both lists
            int[] del = new int[n / 10];
            for (int k = 0; k < del.length; k++) {
                del[k] = rnd.nextInt(n - k); // list gets smaller after every remove
            }

            Test(new ArrayList<Vehicle>(), "ArrayList", cars, del);
            Test(new LinkedList<Vehicle>(), "LinkedList", cars, del);
        }

        System.out.println();
        System.out.println("===== ИТОГ (время в наносекундах) =====");
        System.out.print(table);
        System.out.println();
        System.out.println("===== РАСШИРЕНИЕ ArrayList =====");
        System.out.print(capacity);

        try {
            log.OpenLog("logs/summary.txt");
            log.Write("ИТОГ (время в наносекундах)");
            log.Write(table);
            log.Write("РАСШИРЕНИЕ ArrayList");
            log.Write(capacity);
        } catch (IOException e) {
            log.AddErr(e);
        } finally {
            log.CloseLog();
        }
        System.out.println("Логи лежат в папке logs");
    }

    // прогрев JVM: первые операции всегда медленные, их не записываем
    private void WarmUp() {
        for (int r = 0; r < 5; r++) {
            List<Vehicle> a = new ArrayList<Vehicle>();
            List<Vehicle> b = new LinkedList<Vehicle>();
            for (int i = 0; i < 10000; i++) {
                Vehicle v = gen.RandomVehicle();
                a.add(v);
                b.add(v);
            }
            for (int i = 0; i < 1000; i++) {
                a.remove(rnd.nextInt(a.size()));
                b.remove(rnd.nextInt(b.size()));
            }
        }
    }

    private void Test(List<Vehicle> list, String name, Vehicle[] cars, int[] del) {
        long[] addTime = new long[cars.length];
        long[] delTime = new long[del.length];

        String start = LocalDateTime.now().format(fmt);
        for (int i = 0; i < cars.length; i++) {
            long prev = System.nanoTime();
            list.add(cars[i]);
            addTime[i] = System.nanoTime() - prev;
        }
        for (int k = 0; k < del.length; k++) {
            long prev = System.nanoTime();
            list.remove(del[k]); // remove by index
            delTime[k] = System.nanoTime() - prev;
        }
        String finish = LocalDateTime.now().format(fmt);

        String file = "logs/" + name + "_" + cars.length + ".txt";
        try {
            log.OpenLog(file);
            log.Write("Start program: " + start);
            log.Write(name);
            for (int i = 0; i < addTime.length; i++) {
                log.Write("add, ID = " + (i + 1) + ", " + addTime[i]);
            }
            WriteStat("add", addTime);
            for (int k = 0; k < delTime.length; k++) {
                log.Write("remove, ID = " + (del[k] + 1) + ", " + delTime[k]);
            }
            WriteStat("remove", delTime);
            // общее время всех операций
            log.Write("allTotalCount = " + (addTime.length + delTime.length));
            log.Write("allTotalTime = " + (Sum(addTime) + Sum(delTime)));
            log.Write("Finish program: " + finish);
        } catch (IOException e) {
            log.AddErr(e);
        } finally {
            log.CloseLog();
        }

        table += name + "\t" + cars.length + "\t" + Sum(addTime) + "\t" + Median(addTime)
                + "\t" + Sum(delTime) + "\t" + Median(delTime) + "\n";
        if (name.equals("ArrayList")) {
            CheckCapacity(addTime);
        }
    }

    private void WriteStat(String op, long[] t) throws IOException {
        log.Write(op + "TotalCount = " + t.length);
        log.Write(op + "TotalTime = " + Sum(t));
        log.Write(op + "MedianTime = " + Median(t));
        log.Write(op + "AverageTime = " + (Sum(t) / t.length));
    }

    private long Sum(long[] t) {
        long s = 0;
        for (int i = 0; i < t.length; i++) s += t[i];
        return s;
    }

    private long Median(long[] t) {
        long[] c = Arrays.copyOf(t, t.length);
        Arrays.sort(c);
        if (c.length % 2 == 1) return c[c.length / 2];
        return (c[c.length / 2 - 1] + c[c.length / 2]) / 2;
    }

    // пункт 6: видно ли расширение массива при add?
    // add с номером cap+1 не помещается и массив растёт
    private void CheckCapacity(long[] addTime) {
        int n = addTime.length;
        long median = Median(addTime);

        // formula from the lab: (oldCapacity * 3) / 2 + 1
        long sum1 = 0;
        int cnt1 = 0;
        int cap = 10;
        while (cap < n) {
            sum1 += addTime[cap]; // element number cap+1
            cnt1++;
            cap = (cap * 3) / 2 + 1;
        }
        // formula in Java 7 and newer: oldCapacity + oldCapacity / 2
        long sum2 = 0;
        int cnt2 = 0;
        String steps = "";
        cap = 10;
        while (cap < n) {
            sum2 += addTime[cap];
            cnt2++;
            if (n == 100000 && cap > 1000) {
                steps += "   ID = " + (cap + 1) + " (ёмкость " + cap + " -> " + (cap + cap / 2) + "): " + addTime[cap] + " нс\n";
            }
            cap = cap + cap / 2;
        }

        capacity += "N = " + n + ": медиана add = " + median + " нс";
        if (cnt1 > 0) capacity += "; шаги по (old*3)/2+1: в среднем " + (sum1 / cnt1) + " нс";
        if (cnt2 > 0) capacity += "; шаги по old+old/2: в среднем " + (sum2 / cnt2) + " нс";
        capacity += "\n" + steps;
    }
}


// Требование 2: можно ли пропустить колонну машин за заданное время
class Solver {
    private ArrayList<Vehicle> cars;
    private int limit;

    public Solver(ArrayList<Vehicle> cars, int limit) {
        this.cars = cars;
        this.limit = limit;
    }

    // сколько минут посты будут проверять все машины в этом порядке.
    // следующая машина едет на пост, который освободится раньше
    public static int FinishTime(ArrayList<Vehicle> list, int postCount) {
        int[] free = new int[postCount];
        for (int i = 0; i < list.size(); i++) {
            int best = 0;
            for (int p = 1; p < postCount; p++) {
                if (free[p] < free[best]) best = p;
            }
            free[best] += list.get(i).GetCheckTime();
        }
        int max = 0;
        for (int p = 0; p < postCount; p++) {
            if (free[p] > max) max = free[p];
        }
        return max;
    }

    // сортировка выбором по времени контроля
    public static ArrayList<Vehicle> Sorted(ArrayList<Vehicle> list, boolean longFirst) {
        ArrayList<Vehicle> res = new ArrayList<Vehicle>(list);
        for (int i = 0; i < res.size(); i++) {
            int best = i;
            for (int j = i + 1; j < res.size(); j++) {
                int a = res.get(j).GetCheckTime();
                int b = res.get(best).GetCheckTime();
                if ((longFirst && a > b) || (!longFirst && a < b)) best = j;
            }
            Vehicle t = res.get(i);
            res.set(i, res.get(best));
            res.set(best, t);
        }
        return res;
    }

    private String Order(ArrayList<Vehicle> list) {
        String s = "";
        for (int i = 0; i < list.size() && i < 15; i++) {
            s += list.get(i).GetNumber() + "(" + list.get(i).GetCheckTime() + ") ";
        }
        if (list.size() > 15) s += "...";
        return s;
    }

    public void Run() {
        System.out.println();
        System.out.println("===== РЕЖИМ РАЗРЕШИМОСТИ =====");
        System.out.println("Машин: " + cars.size() + ", надо пропустить за " + limit + " мин");
        int one = FinishTime(cars, 1);
        System.out.println("Сейчас работает 1 пост, машины едут как приехали: нужно " + one + " мин");

        if (one <= limit) {
            System.out.println("РАЗРЕШИМО: один пост успевает, запас " + (limit - one) + " мин");
        } else {
            System.out.println("НЕ РАЗРЕШИМО при текущих условиях. Варианты:");
            int n = 0;

            // 1. open more posts from the start
            for (int k = 2; k <= 3; k++) {
                int t = FinishTime(cars, k);
                if (t <= limit) {
                    n++;
                    System.out.println(n + ") сразу открыть " + k + " поста, порядок не менять: " + t + " мин");
                    break;
                }
            }

            // 2. change order: long checks first, short ones fill the gaps
            ArrayList<Vehicle> longFirst = Sorted(cars, true);
            for (int k = 2; k <= 3; k++) {
                int t = FinishTime(longFirst, k);
                if (t <= limit && FinishTime(cars, k) > limit) {
                    n++;
                    System.out.println(n + ") изменить порядок (сначала машины с долгим контролем) и открыть "
                            + k + " поста: " + t + " мин");
                    System.out.println("   новый порядок: " + Order(longFirst));
                    break;
                }
            }

            // 3. even 3 posts are not enough
            if (n == 0) {
                int best = FinishTime(longFirst, 3);
                if (FinishTime(cars, 3) < best) best = FinishTime(cars, 3);
                System.out.println("Даже 3 поста не успевают, в лучшем варианте нужно " + best + " мин.");
                n++;
                System.out.println(n + ") увеличить допустимое время до " + best + " мин (3 поста)");

                ArrayList<Vehicle> shortFirst = Sorted(cars, false);
                ArrayList<Vehicle> part = new ArrayList<Vehicle>();
                for (int i = 0; i < shortFirst.size(); i++) {
                    part.add(shortFirst.get(i));
                    if (FinishTime(part, 3) > limit) {
                        part.remove(part.size() - 1);
                        break;
                    }
                }
                n++;
                if (part.size() > 0) {
                    System.out.println(n + ") разделить колонну: за " + limit + " мин 3 поста пропустят " + part.size()
                            + " машин (с коротким контролем), остальные " + (cars.size() - part.size()) + " - следующей партией");
                } else {
                    System.out.println(n + ") за " + limit + " мин нельзя проверить даже одну машину, время надо увеличить");
                }
            }
        }

        // кого не пропустят и что можно исправить
        System.out.println();
        System.out.println("Машины, которые не пройдут контроль, и что исправить:");
        int bad = 0;
        for (int i = 0; i < cars.size(); i++) {
            Vehicle v = cars.get(i);
            if (!v.Pass()) {
                bad++;
                if (bad <= 20) {
                    System.out.println("  " + v.GetType() + " " + v.GetNumber() + ": " + v.GetReason());
                    System.out.println("     -> " + v.Advice());
                }
            }
        }
        if (bad > 20) System.out.println("  ... и ещё " + (bad - 20) + " машин");
        if (bad == 0) System.out.println("  все машины пройдут контроль");
    }
}


// Транспортное средство (абстрактный класс) - главный класс
abstract class Vehicle {
    // классы груза
    public static final String SAFE = "безопасный";
    public static final String FIRE = "огнеопасный";
    public static final String CHEMICAL = "химически опасный";
    public static final String BOOM = "взрывоопасный";
    public static final String SPECIAL = "особой важности";
    public static final String[] CARGO = {SAFE, FIRE, CHEMICAL, BOOM, SPECIAL};

    private String number;
    private double length;
    private double width;
    private double height;
    private double weight;
    private int speed;
    private String cargo;
    private int arriveTime; // minute when came to queue
    protected String reason = "";

    protected Vehicle(String number, double length, double width, double height,
                      double weight, int speed, String cargo) {
        this.number = number;
        this.length = length;
        this.width = width;
        this.height = height;
        this.weight = weight;
        this.speed = speed;
        this.cargo = cargo;
    }

    public String GetNumber() {
        return number;
    }

    public int GetSpeed() {
        return speed;
    }

    public String GetCargo() {
        return cargo;
    }

    public String GetReason() {
        return reason;
    }

    public int GetArriveTime() {
        return arriveTime;
    }

    public void SetArriveTime(int arriveTime) {
        this.arriveTime = arriveTime;
    }

    // every type has own limits
    public abstract String GetType();
    public abstract double GetMaxLength();
    public abstract double GetMaxWidth();
    public abstract double GetMaxHeight();
    public abstract double GetMaxWeight();
    public abstract int GetMaxSpeed();

    public boolean IsDangerous() {
        return cargo.equals(FIRE) || cargo.equals(CHEMICAL) || cargo.equals(BOOM);
    }

    // разрешённая скорость с учётом груза
    public int GetSpeedLimit() {
        int maxSpeed = GetMaxSpeed();
        if (IsDangerous() && maxSpeed > 20) maxSpeed = 20; // dangerous cargo - slow
        return maxSpeed;
    }

    // время контроля = размер машины + груз
    public int GetCheckTime() {
        int t;
        if (length <= 5) t = 1;        // small car
        else if (length <= 10) t = 2;
        else if (length <= 15) t = 3;
        else t = 4;                    // long trailer
        if (cargo.equals(FIRE) || cargo.equals(SPECIAL)) t += 2;
        if (cargo.equals(CHEMICAL)) t += 3;
        if (cargo.equals(BOOM)) t += 5;
        return t;
    }

    // проверка габаритов, массы и скорости
    public boolean Pass() {
        reason = "";
        if (length > GetMaxLength()) reason += "длина больше " + GetMaxLength() + "; ";
        if (width > GetMaxWidth()) reason += "ширина больше " + GetMaxWidth() + "; ";
        if (height > GetMaxHeight()) reason += "высота больше " + GetMaxHeight() + "; ";
        if (weight > GetMaxWeight()) reason += "масса больше " + GetMaxWeight() + "; ";

        int maxSpeed = GetMaxSpeed();
        if (IsDangerous() && maxSpeed > 20) maxSpeed = 20; // dangerous cargo - slow
        if (speed > maxSpeed) reason += "скорость больше " + maxSpeed + "; ";

        return reason.equals("");
    }

    // можно ли этой машине везти такой груз (в подклассах свои правила)
    public boolean CargoAllowed() {
        return true;
    }

    // что реально можно изменить, чтобы машину пропустили.
    // размеры машины уменьшить нельзя - такое не предлагаем
    public String Advice() {
        String a = "";
        int limit = GetSpeedLimit();
        if (!CargoAllowed()) {
            if (cargo.equals(BOOM)) a += "перегрузить груз на трейлер; ";
            else a += "перегрузить груз на грузовик; ";
            limit = GetMaxSpeed(); // without this cargo the usual limit
        }
        if (length > GetMaxLength() || width > GetMaxWidth() || height > GetMaxHeight()) {
            a += "габариты изменить нельзя - нужна машина другого типа; ";
        }
        if (weight > GetMaxWeight()) {
            a += "разгрузить " + Math.round((weight - GetMaxWeight()) * 10) / 10.0 + " т; ";
        }
        if (speed > limit) {
            a += "снизить скорость до " + limit + " км/ч; ";
        }
        return a;
    }

    public String toString() {
        return GetType() + " " + number + ": " + length + "x" + width + "x" + height
                + " м, " + weight + " т, " + speed + " км/ч, груз " + cargo;
    }
}


