import java.util.ArrayList;
import java.util.LinkedList;
import java.util.Random;
import java.util.Scanner;

// Лабораторная работа №2, вариант с_7
// Модель пропускного автомобильного пункта
public class Main {
    static Scanner in = new Scanner(System.in);

    public static void main(String[] args) {
        while (true) {
            System.out.println();
            System.out.println("===== ПУНКТ ПРОПУСКА =====");
            System.out.println("1 - Демонстрация метода Pass (готовые машины)");
            System.out.println("2 - Проверить свою машину (ввод с клавиатуры)");
            System.out.println("3 - Моделирование очереди (3 поста + генератор)");
            System.out.println("0 - Выход");
            System.out.print("Ваш выбор: ");
            int choice = ReadInt();

            if (choice == 1) {
                Demo();
            } else if (choice == 2) {
                UserCar();
            } else if (choice == 3) {
                Modeling();
            } else if (choice == 0) {
                System.out.println("Bye!");
                break;
            } else {
                System.out.println("Нет такого пункта");
            }
        }
    }

    // part 3: different vehicles go through the post
    static void Demo() {
        // Vehicle v = new Vehicle(...) - error, class is abstract!
        Vehicle[] cars = {
            new Car("А123ВС", 4.5, 1.8, 1.5, 1.6, 50, CargoType.SAFE),          // ok
            new Car("В777ОР", 4.8, 1.9, 1.6, 2.0, 75, CargoType.SAFE),          // too fast
            new Car("Е001КХ", 4.9, 1.9, 1.7, 2.2, 40, CargoType.FLAMMABLE),     // bad cargo
            new Truck("К555МН", 10.0, 2.5, 3.8, 20.0, 35, CargoType.SAFE),      // ok
            new Truck("М404ТТ", 11.0, 2.5, 3.9, 30.0, 15, CargoType.CHEMICAL),  // too heavy
            new Bus("Н321АА", 12.0, 2.5, 3.5, 15.0, 30, CargoType.SAFE),        // ok
            new Bus("О999СС", 12.0, 2.5, 3.5, 15.0, 30, CargoType.FLAMMABLE),   // bad cargo
            new Trailer("Р100ХУ", 16.5, 2.55, 4.0, 40.0, 10, CargoType.EXPLOSIVE), // ok, slow
            new Trailer("С200УК", 16.5, 2.55, 4.3, 40.0, 25, CargoType.EXPLOSIVE), // high + fast
            new CarWithTrailer("Т300ЕЕ", 8.0, 2.0, 2.5, 3.0, 30, CargoType.SAFE)   // ok
        };

        for (Vehicle v : cars) {
            System.out.println(v); // toString works here
            CheckOne(v);
            System.out.println();
        }
    }

    // polymorphism: v.Pass() calls method of real class (Car, Truck ...)
    static void CheckOne(Vehicle v) {
        if (v.Pass()) {
            System.out.println("  -> ПРОПУЩЕН. Время контроля: " + v.GetCheckTime() + " мин");
        } else {
            System.out.println("  -> НЕ ПРОПУЩЕН: " + v.GetProblems());
        }
    }

    static void UserCar() {
        System.out.println("Тип: 1-легковая, 2-грузовик, 3-автобус, 4-трейлер, 5-авто с прицепом");
        int type = ReadInt();
        System.out.print("Номер: ");
        String num = in.next();
        System.out.print("Длина (м): ");
        double l = ReadDouble();
        System.out.print("Ширина (м): ");
        double w = ReadDouble();
        System.out.print("Высота (м): ");
        double h = ReadDouble();
        System.out.print("Масса (т): ");
        double m = ReadDouble();
        System.out.print("Скорость (км/ч): ");
        int s = ReadInt();
        System.out.println("Груз: 1-безопасный, 2-огнеопасный, 3-хим. опасный, 4-взрывоопасный, 5-особой важности");
        int c = ReadInt();
        CargoType cargo = CargoType.values()[c - 1]; // no input check in this lab (ЛР №4)

        Vehicle v;
        switch (type) {
            case 1:  v = new Car(num, l, w, h, m, s, cargo); break;
            case 2:  v = new Truck(num, l, w, h, m, s, cargo); break;
            case 3:  v = new Bus(num, l, w, h, m, s, cargo); break;
            case 4:  v = new Trailer(num, l, w, h, m, s, cargo); break;
            default: v = new CarWithTrailer(num, l, w, h, m, s, cargo);
        }
        System.out.println(v);
        System.out.println("Ограничения: длина<=" + v.GetMaxLength() + ", ширина<=" + v.GetMaxWidth()
                + ", высота<=" + v.GetMaxHeight() + ", масса<=" + v.GetMaxWeight()
                + ", скорость<=" + v.GetMaxSpeed());
        CheckOne(v);
    }

    // part 4: generator + 3 posts
    static void Modeling() {
        System.out.println("Поток машин: 1-слабый, 2-средний, 3-сильный, 4-свой");
        int f = ReadInt();
        int minGap, maxGap;
        if (f == 1) {
            minGap = 4; maxGap = 8;
        } else if (f == 2) {
            minGap = 1; maxGap = 4;
        } else if (f == 3) {
            minGap = 0; maxGap = 2;
        } else {
            System.out.print("Мин. интервал между машинами (мин): ");
            minGap = ReadInt();
            System.out.print("Макс. интервал между машинами (мин): ");
            maxGap = ReadInt();
        }
        System.out.print("Сколько минут моделировать: ");
        int time = ReadInt();

        System.out.println("Интервал между машинами: " + minGap + ".." + maxGap + " мин");
        Simulation sim = new Simulation(minGap, maxGap, time);
        sim.Run();
    }

    // small helpers. replace ',' because russian Windows writes 3,5
    static int ReadInt() {
        return Integer.parseInt(in.next().trim());
    }

    static double ReadDouble() {
        return Double.parseDouble(in.next().replace(',', '.'));
    }
}


// Классы груза (cargo types)
// extraTime - how many minutes we add to check this cargo
enum CargoType {
    SAFE("безопасный", 0, false),
    FLAMMABLE("огнеопасный", 2, true),
    CHEMICAL("химически опасный", 3, true),
    EXPLOSIVE("взрывоопасный", 5, true),
    SPECIAL("особой важности", 2, false);

    private String name;
    private int extraTime;
    private boolean dangerous;

    CargoType(String name, int extraTime, boolean dangerous) {
        this.name = name;
        this.extraTime = extraTime;
        this.dangerous = dangerous;
    }

    public String GetName() {
        return name;
    }

    public int GetExtraTime() {
        return extraTime;
    }

    // dangerous cargo = slow speed on the post
    public boolean IsDangerous() {
        return dangerous;
    }
}


// Абстрактный класс "Транспортное средство"
// we can not create just "Vehicle", only Car, Truck, Bus ...
abstract class Vehicle {
    // max speed for dangerous cargo (for all types)
    public static final int DANGER_MAX_SPEED = 20;

    private String number;   // гос. номер
    private double length;   // длина, м
    private double width;    // ширина, м
    private double height;   // высота, м
    private double weight;   // масса, т
    private int speed;       // скорость на въезде, км/ч
    private CargoType cargo; // класс груза

    private int arriveMinute; // for queue (part 4)
    protected String problems = ""; // why car can not pass

    protected Vehicle(String number, double length, double width, double height,
                      double weight, int speed, CargoType cargo) {
        this.number = number;
        this.length = length;
        this.width = width;
        this.height = height;
        this.weight = weight;
        this.speed = speed;
        this.cargo = cargo;
    }

    // ---- getters / setters ----
    public String GetNumber() {
        return number;
    }

    public double GetLength() {
        return length;
    }

    public double GetWidth() {
        return width;
    }

    public double GetHeight() {
        return height;
    }

    public double GetWeight() {
        return weight;
    }

    public int GetSpeed() {
        return speed;
    }

    public void SetSpeed(int speed) {
        this.speed = speed;
    }

    public CargoType GetCargo() {
        return cargo;
    }

    public int GetArriveMinute() {
        return arriveMinute;
    }

    public void SetArriveMinute(int arriveMinute) {
        this.arriveMinute = arriveMinute;
    }

    public String GetProblems() {
        return problems;
    }

    protected void AddProblem(String text) {
        problems += text + "; ";
    }

    // ---- limits, every child class must say its own ----
    public abstract String GetTypeName();
    public abstract double GetMaxLength();
    public abstract double GetMaxWidth();
    public abstract double GetMaxHeight();
    public abstract double GetMaxWeight();
    public abstract int GetMaxSpeed();
    protected abstract int GetBaseCheckTime(); // minutes, depends on size

    // время прохождения контроля = размер машины + тип груза
    public int GetCheckTime() {
        return GetBaseCheckTime() + cargo.GetExtraTime();
    }

    // Метод Pass - check size, weight and speed
    // children override it and add cargo rules
    public boolean Pass() {
        problems = "";

        if (length > GetMaxLength())
            AddProblem("длина " + length + " > " + GetMaxLength() + " м");
        if (width > GetMaxWidth())
            AddProblem("ширина " + width + " > " + GetMaxWidth() + " м");
        if (height > GetMaxHeight())
            AddProblem("высота " + height + " > " + GetMaxHeight() + " м");
        if (weight > GetMaxWeight())
            AddProblem("масса " + weight + " > " + GetMaxWeight() + " т");

        int maxSpeed = GetMaxSpeed();
        if (cargo.IsDangerous() && maxSpeed > DANGER_MAX_SPEED) {
            maxSpeed = DANGER_MAX_SPEED; // dangerous -> go slow
        }
        if (speed > maxSpeed)
            AddProblem("скорость " + speed + " > " + maxSpeed + " км/ч");

        return problems.isEmpty();
    }

    // переопределяем toString (like in the example with Human)
    public String toString() {
        return GetTypeName() + " [" + number + "] " + length + "x" + width + "x" + height + " м, "
                + weight + " т, " + speed + " км/ч, груз: " + cargo.GetName();
    }
}


// Легковая машина
class Car extends Vehicle {

    public Car(String number, double length, double width, double height,
               double weight, int speed, CargoType cargo) {
        super(number, length, width, height, weight, speed, cargo); // call parent constructor
    }

    public String GetTypeName() {
        return "Легковая";
    }

    public double GetMaxLength() {
        return 5.0;
    }

    public double GetMaxWidth() {
        return 2.0;
    }

    public double GetMaxHeight() {
        return 2.0;
    }

    public double GetMaxWeight() {
        return 3.5;
    }

    public int GetMaxSpeed() {
        return 60;
    }

    protected int GetBaseCheckTime() {
        return 1; // small car - fast check
    }

    // car can carry only safe cargo or special (documents, money...)
    @Override
    public boolean Pass() {
        boolean ok = super.Pass();
        if (GetCargo() != CargoType.SAFE && GetCargo() != CargoType.SPECIAL) {
            AddProblem("легковой нельзя везти " + GetCargo().GetName() + " груз");
            ok = false;
        }
        return ok;
    }
}


// Грузовик
class Truck extends Vehicle {

    public Truck(String number, double length, double width, double height,
                 double weight, int speed, CargoType cargo) {
        super(number, length, width, height, weight, speed, cargo);
    }

    public String GetTypeName() {
        return "Грузовик";
    }

    public double GetMaxLength() {
        return 12.0;
    }

    public double GetMaxWidth() {
        return 2.55;
    }

    public double GetMaxHeight() {
        return 4.0;
    }

    public double GetMaxWeight() {
        return 26.0;
    }

    public int GetMaxSpeed() {
        return 40;
    }

    protected int GetBaseCheckTime() {
        return 3;
    }

    // truck can carry everything except explosive (only trailer can)
    @Override
    public boolean Pass() {
        boolean ok = super.Pass();
        if (GetCargo() == CargoType.EXPLOSIVE) {
            AddProblem("взрывоопасный груз только на спец. трейлере");
            ok = false;
        }
        return ok;
    }
}


