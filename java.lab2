// Трейлер (седельный тягач с полуприцепом)
class Trailer extends Vehicle {

    public Trailer(String number, double length, double width, double height,
                   double weight, int speed, CargoType cargo) {
        super(number, length, width, height, weight, speed, cargo);
    }

    public String GetTypeName() {
        return "Трейлер";
    }

    public double GetMaxLength() {
        return 20.0;
    }

    public double GetMaxWidth() {
        return 2.55;
    }

    public double GetMaxHeight() {
        return 4.0;
    }

    public double GetMaxWeight() {
        return 44.0;
    }

    public int GetMaxSpeed() {
        return 30;
    }

    protected int GetBaseCheckTime() {
        return 4; // big one - long check
    }

    // trailer can carry any cargo,
    // but explosive one must go very slow (10 km/h)
    @Override
    public boolean Pass() {
        boolean ok = super.Pass();
        if (GetCargo() == CargoType.EXPLOSIVE && GetSpeed() > 10) {
            AddProblem("со взрывоопасным грузом не больше 10 км/ч");
            ok = false;
        }
        return ok;
    }
}


