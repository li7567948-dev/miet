            ok = false;
        }
        return ok;
    }
}


// Один пункт пропуска (one post / one line)
class CheckPoint {
    private int id;
    private boolean open = false;
    private Vehicle current = null; // car on the post now
    private int timeLeft = 0;       // minutes left for this car
    private int served = 0;         // how many cars checked

    public CheckPoint(int id) {
        this.id = id;
    }

    public int GetId() {
        return id;
    }

    public boolean IsOpen() {
        return open;
    }

    public void Open() {
        open = true;
    }

    public void Close() {
        open = false;
    }

    public boolean IsFree() {
        return current == null;
    }

    public int GetTimeLeft() {
        return timeLeft;
    }

    public int GetServed() {
        return served;
    }

    // take next car from queue
    public void Take(Vehicle v) {
        current = v;
        timeLeft = v.GetCheckTime();
    }

    // one minute goes. If car is done - return it, else null
    public Vehicle Tick() {
        if (current == null)
            return null;
        timeLeft--;
        if (timeLeft <= 0) {
            Vehicle done = current;
            current = null;
            served++;
            return done;
        }
        return null;
    }
}


// Генератор машин: random cars, random time between them (in range)
class CarGenerator {
    private Random rnd = new Random();
    private int minGap; // min minutes between cars
    private int maxGap; // max minutes between cars
    private int nextArrival = 0;

    private static final String LETTERS = "АВЕКМНОРСТУХ"; // letters for car numbers

    public CarGenerator(int minGap, int maxGap) {
        this.minGap = minGap;
        this.maxGap = maxGap;
    }

    // all cars that come at this minute
    public ArrayList<Vehicle> Generate(int minute) {
        ArrayList<Vehicle> list = new ArrayList<Vehicle>();
        while (nextArrival <= minute) {
            list.add(RandomVehicle());
            nextArrival += minGap + rnd.nextInt(maxGap - minGap + 1);
        }
        return list;
    }

    // random double from a to b, round to 0.1
    private double Rand(double a, double b) {
        double x = a + rnd.nextDouble() * (b - a);
        return Math.round(x * 10) / 10.0;
    }

    private int Rand(int a, int b) {
        return a + rnd.nextInt(b - a + 1);
    }

    private String RandomNumber() {
        String s = "";
        s += LETTERS.charAt(rnd.nextInt(LETTERS.length()));
        s += Rand(100, 999);
        s += LETTERS.charAt(rnd.nextInt(LETTERS.length()));
        s += LETTERS.charAt(rnd.nextInt(LETTERS.length()));
        return s;
    }

    private CargoType RandomCargo() {
        // most cars are safe, about 75%
        if (rnd.nextInt(100) < 75)
            return CargoType.SAFE;
        CargoType[] all = CargoType.values();
        return all[rnd.nextInt(all.length)];
    }

    // speed: drivers with dangerous cargo usually go slow
    private int RandSpeed(int min, int max, CargoType cargo) {
        if (cargo.IsDangerous())
            return Rand(5, 22);
        return Rand(min, max);
    }

    // ranges are a bit bigger than limits, so some cars will fail - it's ok
    public Vehicle RandomVehicle() {
        String num = RandomNumber();
        CargoType cargo = RandomCargo();
        int type = rnd.nextInt(5);

        switch (type) {
            case 0:
                return new Car(num, Rand(3.5, 5.1), Rand(1.6, 2.0), Rand(1.4, 2.0),
                        Rand(1.0, 3.6), RandSpeed(20, 62, cargo), cargo);
            case 1:
                return new Truck(num, Rand(6.0, 12.2), Rand(2.2, 2.55), Rand(2.8, 4.1),
                        Rand(5.0, 27.0), RandSpeed(10, 41, cargo), cargo);
            case 2:
                return new Bus(num, Rand(8.0, 15.0), Rand(2.3, 2.55), Rand(2.8, 4.0),
                        Rand(8.0, 18.5), RandSpeed(15, 41, cargo), cargo);
            case 3:
                return new Trailer(num, Rand(14.0, 20.3), Rand(2.45, 2.55), Rand(3.5, 4.05),
                        Rand(15.0, 45.0), RandSpeed(5, 31, cargo), cargo);
            default:
                return new CarWithTrailer(num, Rand(6.0, 10.2), Rand(1.8, 2.2), Rand(1.5, 3.0),
                        Rand(2.0, 5.2), RandSpeed(15, 42, cargo), cargo);
        }
    }
}


// Моделирование работы пункта пропуска (part 4)
// post 1 always open, post 2 and 3 open when wait > 10 min
class Simulation {
    public static final int MAX_WAIT = 10; // minutes

    private CheckPoint[] posts = new CheckPoint[3];
    private LinkedList<Vehicle> queue = new LinkedList<Vehicle>();
    private CarGenerator generator;
    private int duration; // minutes when new cars come

    // statistics
    private int arrived = 0;
    private int passed = 0;
    private int rejected = 0;
    private int maxQueue = 0;
    private int totalWait = 0;
    private int maxWait = 0;
    private int startedChecks = 0;

    public Simulation(int minGap, int maxGap, int duration) {
        generator = new CarGenerator(minGap, maxGap);
        this.duration = duration;
        for (int i = 0; i < posts.length; i++) {
            posts[i] = new CheckPoint(i + 1);
        }
        posts[0].Open(); // first post always works
    }

    private int OpenCount() {
        int n = 0;
        for (CheckPoint p : posts)
            if (p.IsOpen()) n++;
        return n;
    }

    // how long new car will wait (approx)
    private int ExpectedWait() {
        int sum = 0;
        for (Vehicle v : queue)
            sum += v.GetCheckTime();
        for (CheckPoint p : posts)
            if (p.IsOpen()) sum += p.GetTimeLeft();
        return sum / OpenCount();
    }

    public void Run() {
        int minute = 0;
        // work until time is over AND everybody is checked
        while (minute < duration || !queue.isEmpty() || !AllFree()) {

            // 1) new cars come
            if (minute < duration) {
                ArrayList<Vehicle> newCars = generator.Generate(minute);
                for (Vehicle v : newCars) {
                    v.SetArriveMinute(minute);
                    queue.add(v);
                    arrived++;
                    System.out.println(Time(minute) + "приехал: " + v);
                }
            } else if (minute == duration) {
                System.out.println(Time(minute) + "--- въезд закрыт, дообслуживаем очередь ---");
            }

            // 2) posts work one minute
            for (CheckPoint p : posts) {
                Vehicle done = p.Tick();
                if (done != null) {
                    if (done.Pass()) {
                        passed++;
                        System.out.println(Time(minute) + "[Пост " + p.GetId() + "] ПРОПУЩЕН: "
                                + done.GetTypeName() + " " + done.GetNumber());
                    } else {
                        rejected++;
                        System.out.println(Time(minute) + "[Пост " + p.GetId() + "] НЕ ПРОПУЩЕН: "
                                + done.GetTypeName() + " " + done.GetNumber() + " (" + done.GetProblems() + ")");
                    }
                }
            }

            // 3) open or close extra posts
            CheckOpenClose(minute);

            // 4) free posts take cars from queue
            for (CheckPoint p : posts) {
                if (p.IsOpen() && p.IsFree() && !queue.isEmpty()) {
                    Vehicle v = queue.poll();
                    int wait = minute - v.GetArriveMinute();
                    totalWait += wait;
                    startedChecks++;
                    if (wait > maxWait) maxWait = wait;
                    p.Take(v);
                }
            }

            if (queue.size() > maxQueue) maxQueue = queue.size();
            minute++;
        }

        PrintResult(minute);
    }

    private void CheckOpenClose(int minute) {
        // open next post if wait is too long
        if (ExpectedWait() > MAX_WAIT) {
            for (CheckPoint p : posts) {
                if (!p.IsOpen()) {
                    p.Open();
                    System.out.println(Time(minute) + ">>> ожидание больше " + MAX_WAIT
                            + " мин, ОТКРЫТ пост " + p.GetId() + " (в очереди " + queue.size() + ")");
                    break; // open only one per minute
                }
            }
        }
        // no queue -> close extra free posts (not post 1)
        if (queue.isEmpty()) {
            for (int i = posts.length - 1; i > 0; i--) {
                if (posts[i].IsOpen() && posts[i].IsFree()) {
                    posts[i].Close();
                    System.out.println(Time(minute) + "<<< очереди нет, ЗАКРЫТ пост " + posts[i].GetId());
                }
            }
        }
    }

    private boolean AllFree() {
        for (CheckPoint p : posts)
            if (!p.IsFree()) return false;
        return true;
    }

    private String Time(int minute) {
        return String.format("%3d мин | ", minute);
    }

    private void PrintResult(int minute) {
        System.out.println();
        System.out.println("========== ИТОГ ==========");
        System.out.println("Время работы: " + minute + " мин");
        System.out.println("Приехало машин: " + arrived);
        System.out.println("Пропущено: " + passed);
        System.out.println("Не пропущено: " + rejected);
        System.out.println("Макс. очередь: " + maxQueue + " машин");
        if (startedChecks > 0) {
            System.out.printf("Среднее ожидание: %.1f мин%n", (double) totalWait / startedChecks);
        }
        System.out.println("Макс. ожидание: " + maxWait + " мин");
        for (CheckPoint p : posts) {
            System.out.println("Пост " + p.GetId() + " проверил: " + p.GetServed() + " машин");
        }
    }
}
